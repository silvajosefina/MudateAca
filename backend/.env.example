DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-con-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=mudateaca
DB_USER=mudateaca_app
DB_PASSWORD=mudateaca_dev_2026
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_COOKIE_SECURE=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@mudateaca.com

FRONTEND_URL=http://localhost:5173

# GeoDjango en Windows: carpeta de OSGeo4W con GDAL y GEOS (en Linux dejar vacío).
OSGEO4W_ROOT=

# Alternativa en Windows si Smart App Control bloquea OSGeo4W: las bibliotecas que instala PostGIS.
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgdal-35.dll
# GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgeos_c.dll
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# Cloudinary (panel de Cloudinary > Settings > API Keys). Vacío: los archivos quedan en carpetas locales.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backups diarios (RNF-11). PG_BIN_DIR: carpeta de pg_dump; vacía si ya está en el PATH.
RESPALDOS_DIR=
PG_BIN_DIR=
