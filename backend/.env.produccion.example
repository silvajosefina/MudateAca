# Variables del servidor de producción. Copiar como .env en /srv/mudateaca/backend y completar.
# Nunca subir el .env real al repositorio.

# Clave secreta nueva, generada en el servidor (ver manual).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mudateaca.duckdns.org

# Dominio público, con https.
CSRF_TRUSTED_ORIGINS=https://mudateaca.duckdns.org
CORS_ALLOWED_ORIGINS=https://mudateaca.duckdns.org
FRONTEND_URL=https://mudateaca.duckdns.org
JWT_COOKIE_SECURE=True

DB_NAME=mudateaca
DB_USER=mudateaca_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Gmail con contraseña de aplicación: el remitente tiene que ser la misma cuenta.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Cuenta de Cloudinary de producción.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# En Linux quedan vacías: GDAL, GEOS, pg_dump y pg_restore ya están en el sistema.
OSGEO4W_ROOT=
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
RESPALDOS_DIR=
PG_BIN_DIR=
